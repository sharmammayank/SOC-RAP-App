# Copy to .env and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Never put the service_role key in this file: it is shipped to the browser.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Set to true after enabling the Azure (Microsoft Entra ID) provider in Supabase → Authentication → Providers.
VITE_AUTH_AZURE_ENABLED=false
