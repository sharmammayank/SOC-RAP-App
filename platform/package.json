    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
